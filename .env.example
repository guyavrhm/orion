# Configure the URL format for your torrent provider.
# Supported formats: XML feeds or custom JSON APIs.
# Available template variables:
#   {imdbId}         - IMDb ID (e.g. tt0052077)
#   {imdbNumericId}  - Numeric IMDb ID without 'tt' (e.g. 0052077)
#   {title}          - URL-encoded title (e.g. Plan%209%20from%20Outer%20Space)
#   {season}         - Season number (e.g. 1)
#   {seasonPad}      - 2-digit zero-padded season (e.g. 01)
#   {episode}        - Episode number (e.g. 1)
#   {episodePad}     - 2-digit zero-padded episode (e.g. 01)
#
# Examples of standard formats (single or comma-separated for multiple providers):
#   TORRENT_MOVIE_PROVIDERS=https://example.com/stream/movie/{imdbId}.json,https://api.example.com/search?q={title}
#   TORRENT_SHOW_PROVIDERS=https://example.com/stream/series/{imdbId}:{season}:{episode}.json,https://api.example.com/search?q={title}+S{seasonPad}E{episodePad}

TORRENT_MOVIE_PROVIDERS=
TORRENT_SHOW_PROVIDERS=

# Optional API key(s) (single key for all, or comma-separated matching provider order).
# Leave slot blank or use 'none' if a provider does not require a key (e.g. ',key_for_second_provider')
# TORRENT_MOVIE_PROVIDER_API_KEYS=
# TORRENT_SHOW_PROVIDER_API_KEYS=

# Server Configuration
PORT=3000
UV_THREADPOOL_SIZE=16  # libuv worker threads for async I/O and media streaming (optimal: 16)

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_DB=0

# Subtitle Languages (comma-separated ISO 639-2 canonical codes)
SUBTITLE_LANGS=eng,spa

# Storage & Eviction Configuration (Max disk usage in GB)
MAX_STORAGE_GB=100

# Queue & Worker Concurrency
# QUEUE_PREFIX=orion
CONCURRENCY_DOWNLOAD=2
CONCURRENCY_TRANSCODE_FAST=1   # Fast Lane: H.264 stream-copy + audio transcode (I/O bound)
CONCURRENCY_TRANSCODE_HEAVY=1  # Heavy Lane: HEVC/AV1 video re-encode (CPU bound)
CONCURRENCY_SUBTITLE=1
CONCURRENCY_FINALIZE=1
