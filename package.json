{
  "name": "orion",
  "version": "0.1.0",
  "description": "Orion Media Streamer (PWA & Home Server)",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/guyavrhm/orion.git"
  },
  "bugs": {
    "url": "https://github.com/guyavrhm/orion/issues"
  },
  "homepage": "https://github.com/guyavrhm/orion#readme",
  "keywords": [
    "media-server",
    "pwa",
    "self-hosted",
    "streaming",
    "subtitles",
    "torrent-tool",
    "transcoding"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx --env-file-if-exists=.env src/main/server.ts",
    "dev:all": "tsx --env-file-if-exists=.env src/main/server.ts --all-in-one",
    "dev:workers": "tsx --env-file-if-exists=.env src/main/workers/index.ts",
    "dev:worker:download": "tsx --env-file-if-exists=.env src/main/workers/index.ts --worker=download",
    "dev:worker:transcode": "tsx --env-file-if-exists=.env src/main/workers/index.ts --worker=transcode",
    "dev:worker:subtitle": "tsx --env-file-if-exists=.env src/main/workers/index.ts --worker=subtitle",
    "dev:worker:finalize": "tsx --env-file-if-exists=.env src/main/workers/index.ts --worker=finalize",
    "build": "vite build",
    "build:backend": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:backend",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env dist/main/server.js",
    "start:all": "node --env-file-if-exists=.env dist/main/server.js --all-in-one",
    "start:api": "node --env-file-if-exists=.env dist/main/server.js",
    "start:workers": "node --env-file-if-exists=.env dist/main/workers/index.js",
    "start:worker:download": "node --env-file-if-exists=.env dist/main/workers/index.js --worker=download",
    "start:worker:transcode": "node --env-file-if-exists=.env dist/main/workers/index.js --worker=transcode",
    "start:worker:subtitle": "node --env-file-if-exists=.env dist/main/workers/index.js --worker=subtitle",
    "start:worker:finalize": "node --env-file-if-exists=.env dist/main/workers/index.js --worker=finalize",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/webtorrent": "^0.110.2",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "bullmq": "^6.1.2",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "hls.js": "^1.7.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "webtorrent": "^2.8.5"
  }
}
